APP_NAME="FoodLab Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# Local: sqlite. Production (Render): DB_CONNECTION=pgsql + DATABASE_URL
# DATABASE_URL=postgres://user:pass@host:5432/foodlab
# DB_HOST=...
# DB_PORT=5432
# DB_DATABASE=foodlab
# DB_USERNAME=...
# DB_PASSWORD=...

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Mail (Brevo / SMTP production) ---
# MVP Render without SMTP: MAIL_MAILER=log + AUTO_VERIFY_EMAIL=true (or omit; defaults on for log/array)
# Official: set smtp + Brevo (or SendGrid) and AUTO_VERIFY_EMAIL=false
# Brevo SMTP example:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=<brevo-login-email>
#   MAIL_PASSWORD=<brevo-smtp-key>
#   MAIL_FROM_ADDRESS=noreply@yourdomain.com
#   MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@foodlab.test"
MAIL_FROM_NAME="${APP_NAME}"

# MVP: auto-verify on register when no real SMTP. Set false when SMTP is configured.
AUTO_VERIFY_EMAIL=true

# --- Google OAuth (Socialite) ---
# Google Cloud Console → OAuth 2.0 Client (Web) → Authorized redirect URI:
#   ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"



# --- FoodLab plans ---
FOODLAB_STARTER_PRICE=0
FOODLAB_PREMIUM_PRICE=149000
FOODLAB_TASTEBOX_PRICE=15000
FOODLAB_CURRENCY=XOF
FOODLAB_MM_PROVIDER=fedapay
MOBILE_MONEY_PROVIDER=fedapay
FOODLAB_VIDEO_PROVIDER=bunny
FOODLAB_CERT_ISSUER="FoodLab Academy"

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SANDBOX=true

# Mobile Money — KKiaPay (legacy)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# Mobile Money — FedaPay (défaut)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_MODE=sandbox
# FEDAPAY_MODE=live
FEDAPAY_WEBHOOK_SECRET=
# legacy alias (si FEDAPAY_MODE absent) :
FEDAPAY_SANDBOX=true

# Vidéo — Bunny (défaut) / Vimeo
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
VIMEO_ACCESS_TOKEN=

# Render / Docker: set true once to seed demo data on deploy
SEED_ON_DEPLOY=false

# --- Backlog V2 ---
# Calendly embed URL for /coaching (leave empty to show request form)
CALENDLY_URL=

# Meta Pixel + Google Tag Manager (injected in layouts when set)
META_PIXEL_ID=
GTM_ID=

# Floating WhatsApp button (prefer WHATSAPP_URL, else build from number)
WHATSAPP_URL=
# Hint from legacy Netlify site (override freely). Digits only, country code included.
WHATSAPP_NUMBER=2290140645201
