APP_NAME="FoodLab Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# Local: sqlite. Production (Render): DB_CONNECTION=pgsql + DATABASE_URL
# DATABASE_URL=postgres://user:pass@host:5432/foodlab
# DB_HOST=...
# DB_PORT=5432
# DB_DATABASE=foodlab
# DB_USERNAME=...
# DB_PASSWORD=...

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@foodlab.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- FoodLab plans ---
FOODLAB_STARTER_PRICE=25000
FOODLAB_PREMIUM_PRICE=75000
FOODLAB_CURRENCY=XOF
FOODLAB_MM_PROVIDER=kkiapay
FOODLAB_VIDEO_PROVIDER=bunny
FOODLAB_CERT_ISSUER="FoodLab Academy"

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SANDBOX=true

# Mobile Money — KKiaPay (défaut)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# Mobile Money — FedaPay (alternative)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_SANDBOX=true

# Vidéo — Bunny (défaut) / Vimeo
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
VIMEO_ACCESS_TOKEN=

# Render / Docker: set true once to seed demo data on deploy
SEED_ON_DEPLOY=false
